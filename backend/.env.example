# Environment Configuration Template for Practical 13 Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_your_secure_jwt_secret_here
MONGO_URI=mongodb://127.0.0.1:27017/taskdb

# Practical 13 - AI Service Keys (Server-side only; NEVER expose to frontend)
# Option A: OpenAI (default model: gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option B: Google Gemini (default model: gemini-1.5-flash)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
